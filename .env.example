# Inductor environment — copy to `.env` and fill in. Never commit the real `.env`.

# Anthropic API key for property synthesis + counterexample classification (M2+).
# Get one at https://console.anthropic.com/. Not needed for `inductor demo` or tests.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-4-8).
# INDUCTOR_MODEL=claude-opus-4-8
